# ==============================================================================
# Google Cloud & Firebase Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to `.env.gcp` (which is ignored by git via `.gitignore`):
#      cp .env.gcp.example .env.gcp
# 2. Replace all `TODO_*` placeholders below with your Google Cloud project values,
#    OR set `GCP_PROJECT_ID` and run `./deploy.sh` to auto-provision and populate
#    the remaining resource identifiers.
# ==============================================================================

# TODO: Replace with your Google Cloud Project ID (e.g., my-healthcare-claims-proj)
GCP_PROJECT_ID=TODO_YOUR_GCP_PROJECT_ID

# TODO: Replace with your numeric Google Cloud Project Number (e.g., 123456789012)
#       Find via: gcloud projects describe $GCP_PROJECT_ID --format="value(projectNumber)"
GCP_PROJECT_NUMBER=TODO_YOUR_GCP_PROJECT_NUMBER

# Primary Google Cloud region for Cloud Storage, Cloud Firestore, and Cloud Run
GCP_REGION=us-central1

# TODO: Replace with your globally unique Google Cloud Storage bucket name
#       (Defaults to ${GCP_PROJECT_ID}-claims-docs when provisioned by ./deploy.sh)
GCS_BUCKET_NAME=TODO_YOUR_GCS_BUCKET_NAME

# Google Cloud Document AI multi-region location (`us` or `eu`)
DOCAI_LOCATION=us

# TODO: Replace with your Document AI OCR Processor ID (e.g., 1a2b3c4d5e6f7g8h)
#       (Auto-created and populated into `.env.gcp` when you run `./deploy.sh`)
DOCAI_PROCESSOR_ID=TODO_YOUR_DOCAI_PROCESSOR_ID

# Firebase / Cloud Firestore collection name for processed claims
FIRESTORE_COLLECTION=claims_documents

# Gemini model used for structured healthcare claims & medical coding extraction
GEMINI_MODEL=gemini-3.8-flash

# Google Cloud Run service name
CLOUD_RUN_SERVICE=claims-processor-app

# Optional: Only needed if not using Application Default Credentials (ADC)
# TODO (Optional): If using an explicit Gemini API key instead of ADC/Vertex, set below:
# GEMINI_API_KEY=TODO_OPTIONAL_GEMINI_API_KEY
